/** Administrator-only master-data and configuration management. */
function listDepartments() { requireAdmin_(); return getSheetData(APP_CONFIG.SHEETS.DEPARTMENTS).sort((a,b) => Number(a['Sequence']) - Number(b['Sequence'])).map(toClientRecord_); }
function listProducts() { requireAdmin_(); return getSheetData(APP_CONFIG.SHEETS.PRODUCTS).map(toClientRecord_); }
function listCustomers() { requireAdmin_(); return getSheetData(APP_CONFIG.SHEETS.CUSTOMERS).map(toClientRecord_); }
function listWorkflowConfiguration() { requireAdmin_(); return getSheetData(APP_CONFIG.SHEETS.WORKFLOW_CONFIG).sort((a,b) => Number(a['Step Number']) - Number(b['Step Number'])); }
function listSystemSettings() { requireAdmin_(); return getSheetData(APP_CONFIG.SHEETS.SETTINGS); }

function saveDepartment(input) { return withScriptLock_(() => saveDepartmentUnderLock_(input)); }
function saveDepartmentUnderLock_(input) {
  const actor = requireAdmin_(); validateDepartmentInput_(input);
  const departments = getSheetData(APP_CONFIG.SHEETS.DEPARTMENTS);
  const duplicateName = departments.some(row => row['Department ID'] !== input.departmentId && String(row['Department Name']).toLowerCase() === String(input.departmentName).trim().toLowerCase());
  const duplicateSequence = departments.some(row => row['Department ID'] !== input.departmentId && Number(row['Sequence']) === Number(input.sequence) && isTrue_(row['Active']) && input.active !== false);
  if (duplicateName) throw new Error('Department name already exists.'); if (duplicateSequence) throw new Error('Active department sequence numbers must be unique.');
  const timestamp = formatNow_();
  if (input.departmentId) {
    const previous = getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, input.departmentId); if (!previous) throw new Error('Department not found.');
    const updated = updateRecord(APP_CONFIG.SHEETS.DEPARTMENTS, input.departmentId, { 'Department Name': String(input.departmentName).trim(), 'Sequence': Number(input.sequence), 'Active': input.active !== false, 'Default Assignee Email': input.defaultAssigneeEmail || '', 'Description': input.description || '', 'Default Task Duration Hours': positiveNumber_(input.defaultTaskDurationHours, 'Default task duration'), 'Updated Date': timestamp });
    writeWorkflowAuditUnderLock_(actor, 'UPDATE_DEPARTMENT', 'DEPARTMENT', input.departmentId, previous, updated, 'Department configuration updated.'); return updated;
  }
  const department = { 'Department ID': generateIdUnderLock_(APP_CONFIG.ID_PREFIXES.DEPARTMENTS), 'Department Name': String(input.departmentName).trim(), 'Sequence': Number(input.sequence), 'Active': input.active !== false, 'Default Assignee Email': input.defaultAssigneeEmail || '', 'Description': input.description || '', 'Created Date': timestamp, 'Updated Date': timestamp, 'Default Task Duration Hours': positiveNumber_(input.defaultTaskDurationHours, 'Default task duration') };
  insertRecord(APP_CONFIG.SHEETS.DEPARTMENTS, department); writeWorkflowAuditUnderLock_(actor, 'CREATE_DEPARTMENT', 'DEPARTMENT', department['Department ID'], null, department, 'Department created.'); return department;
}
function deactivateDepartment(departmentId) { return saveDepartment(Object.assign({}, getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, departmentId), { departmentId, departmentName: getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, departmentId)['Department Name'], sequence: getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, departmentId)['Sequence'], active: false, defaultTaskDurationHours: getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, departmentId)['Default Task Duration Hours'] || 8 })); }

function saveProduct(input) { return withScriptLock_(() => saveMasterRecordUnderLock_(APP_CONFIG.SHEETS.PRODUCTS, APP_CONFIG.ID_PREFIXES.PRODUCTS, 'PRODUCT', input, validateProductInput_)); }
function saveCustomer(input) { return withScriptLock_(() => saveMasterRecordUnderLock_(APP_CONFIG.SHEETS.CUSTOMERS, APP_CONFIG.ID_PREFIXES.CUSTOMERS, 'CUSTOMER', input, validateCustomerInput_)); }
function deactivateProduct(productId) { return deactivateMasterRecord_(APP_CONFIG.SHEETS.PRODUCTS, productId, 'PRODUCT'); }
function deactivateCustomer(customerId) { return deactivateMasterRecord_(APP_CONFIG.SHEETS.CUSTOMERS, customerId, 'CUSTOMER'); }
function saveMasterRecordUnderLock_(sheetName, prefix, entityType, input, validator) {
  const actor = requireAdmin_(); validator(input); const headers = getSheetSchemas_()[sheetName]; const idField = headers[0]; const id = input.id || input[idField] || '';
  const timestamp = formatNow_(); const existing = id ? getRecordById(sheetName, id) : null; if (id && !existing) throw new Error(entityType + ' not found.');
  const nameField = entityType === 'PRODUCT' ? 'Product Name' : entityType === 'CUSTOMER' ? 'Customer Name' : '';
  if (nameField && getSheetData(sheetName).some(row => row[idField] !== id && String(row[nameField]).trim().toLowerCase() === String(input[masterInputKey_(nameField)] || '').trim().toLowerCase())) throw new Error(entityType + ' name already exists.');
  const record = headers.reduce((value, header) => { value[header] = input[masterInputKey_(header)] !== undefined ? input[masterInputKey_(header)] : (existing ? existing[header] : ''); return value; }, {});
  record[idField] = existing ? id : generateIdUnderLock_(prefix); record['Active'] = input.active === undefined ? (existing ? existing['Active'] : true) : input.active === true; record['Created Date'] = existing ? existing['Created Date'] : timestamp; record['Updated Date'] = timestamp;
  if (existing) { const updated = updateRecord(sheetName, id, record); writeWorkflowAuditUnderLock_(actor, 'UPDATE_' + entityType, entityType, id, existing, updated, 'Master record updated.'); return updated; }
  insertRecord(sheetName, record); writeWorkflowAuditUnderLock_(actor, 'CREATE_' + entityType, entityType, record[idField], null, record, 'Master record created.'); return record;
}
function deactivateMasterRecord_(sheetName, id, entityType) { return withScriptLock_(() => { const actor = requireAdmin_(); const existing = getRecordById(sheetName, id); if (!existing) throw new Error(entityType + ' not found.'); const updated = updateRecord(sheetName, id, { 'Active': false, 'Updated Date': formatNow_() }); writeWorkflowAuditUnderLock_(actor, 'DEACTIVATE_' + entityType, entityType, id, existing, updated, 'Historical record preserved; master record deactivated.'); return updated; }); }
function masterInputKey_(header) { return ({ 'Product ID':'productId','Customer ID':'customerId','Product Name':'productName','Customer Name':'customerName','Contact Name':'contactName','Contact Person':'contactName','Standard Production Time Hours':'standardProductionTimeHours','Selling Price':'sellingPrice','Cost Price':'costPrice' })[header] || header.replace(/ ([A-Z])/g, (_,letter) => letter.toUpperCase()).replace(/ /g,'').replace(/^./, letter => letter.toLowerCase()); }

function saveWorkflowConfiguration(steps) { return withScriptLock_(() => saveWorkflowConfigurationUnderLock_(steps)); }
function saveWorkflowConfigurationUnderLock_(steps) {
  const actor = requireAdmin_(); validateWorkflowSteps_(steps); const old = getSheetData(APP_CONFIG.SHEETS.WORKFLOW_CONFIG); const headers = getSheetSchemas_()[APP_CONFIG.SHEETS.WORKFLOW_CONFIG]; const sheet = getSpreadsheet_().getSheetByName(APP_CONFIG.SHEETS.WORKFLOW_CONFIG); const timestamp = formatNow_();
  steps.forEach(step => { const key = String(step.workflowId || 'STANDARD_GARMENT_PIPELINE') + '|' + Number(step.stepNumber); const rowIndex = old.findIndex(row => String(row['Workflow ID']) + '|' + Number(row['Step Number']) === key); const department = getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, step.departmentId); const record = { 'Workflow ID': step.workflowId || 'STANDARD_GARMENT_PIPELINE', 'Workflow Name': step.workflowName || 'Standard Garment Pipeline', 'Step Number': Number(step.stepNumber), 'Department ID': step.departmentId, 'Department Name': department['Department Name'], 'Task Name Template': step.taskNameTemplate || '{Department Name} - {Product Name}', 'Required Completion Percent': Number(step.requiredCompletionPercent || getSettingValue_('DEFAULT_COMPLETION_PERCENT','100')), 'Active': step.active !== false, 'Created Date': rowIndex >= 0 ? old[rowIndex]['Created Date'] : timestamp, 'Updated Date': timestamp, 'Is Required': step.isRequired !== false, 'Default Duration Hours': positiveNumber_(step.defaultDurationHours || department['Default Task Duration Hours'] || 8, 'Stage duration') };
    if (rowIndex >= 0) sheet.getRange(rowIndex + 2, 1, 1, headers.length).setValues([headers.map(header => record[header])]); else insertRecord(APP_CONFIG.SHEETS.WORKFLOW_CONFIG, record);
  });
  writeWorkflowAuditUnderLock_(actor, 'UPDATE_WORKFLOW_CONFIGURATION', 'WORKFLOW', 'STANDARD_GARMENT_PIPELINE', old, steps, 'Workflow configuration validated and saved.'); return listWorkflowConfiguration();
}

function updateSystemSetting(key, value) { return withScriptLock_(() => { const actor = requireAdmin_(); const setting = getSheetData(APP_CONFIG.SHEETS.SETTINGS).find(row => row['Setting Key'] === key); if (!setting) throw new Error('Unknown setting.'); const normalized = validateSettingValue_(key, value); const updated = updateRecord(APP_CONFIG.SHEETS.SETTINGS, key, { 'Setting Value': normalized, 'Updated Date': formatNow_(), 'Updated By': actor['Email'] }); invalidateSettingCache_(key); writeWorkflowAuditUnderLock_(actor, 'UPDATE_SETTING', 'SETTING', key, setting, updated, 'System setting updated.'); return updated; }); }

function validateDepartmentInput_(input) { if (!input || !String(input.departmentName || '').trim()) throw new Error('Department name is required.'); if (!Number.isInteger(Number(input.sequence)) || Number(input.sequence) < 1) throw new Error('Department sequence must be a positive whole number.'); }
function validateProductInput_(input) { if (!input || !String(input.productName || '').trim()) throw new Error('Product name is required.'); if (input.costPrice !== undefined && Number(input.costPrice) < 0 || input.sellingPrice !== undefined && Number(input.sellingPrice) < 0) throw new Error('Prices cannot be negative.'); }
function validateCustomerInput_(input) { if (!input || !String(input.customerName || '').trim()) throw new Error('Customer name is required.'); if (input.email && !isValidNotificationEmail_(input.email)) throw new Error('Customer email is invalid.'); }
function validateWorkflowSteps_(steps) { if (!Array.isArray(steps) || !steps.length) throw new Error('At least one workflow step is required.'); const active = steps.filter(step => step.active !== false); if (!active.some(step => step.isRequired !== false)) throw new Error('At least one active required workflow stage is required.'); const sequences = active.map(step => Number(step.stepNumber)); if (sequences.some(value => !Number.isInteger(value) || value < 1) || new Set(sequences).size !== sequences.length) throw new Error('Active workflow step numbers must be unique positive integers.'); active.forEach(step => { const department = getRecordById(APP_CONFIG.SHEETS.DEPARTMENTS, step.departmentId); if (!department || !isTrue_(department['Active'])) throw new Error('Every active workflow step must use an active department.'); }); }
function positiveNumber_(value, label) { const number = Number(value); if (!Number.isFinite(number) || number <= 0) throw new Error(label + ' must be greater than zero.'); return number; }
function validateSettingValue_(key, value) { const text = String(value).trim(); const booleanKeys = ['NOTIFICATIONS_ENABLED','EMAIL_NOTIFICATIONS_ENABLED','PARTIAL_COMPLETION_ALLOWED']; const numberKeys = ['OVERDUE_WARNING_HOURS','DEFAULT_COMPLETION_PERCENT','DEFAULT_TASK_DURATION_HOURS','DELIVERY_RISK_THRESHOLD_HOURS']; if (booleanKeys.includes(key) && !['TRUE','FALSE'].includes(text.toUpperCase())) throw new Error('Setting must be TRUE or FALSE.'); if (numberKeys.includes(key) && (!Number.isFinite(Number(text)) || Number(text) < 0 || (key === 'DEFAULT_COMPLETION_PERCENT' && Number(text) > 100))) throw new Error('Setting value is invalid.'); if (key === 'DEFAULT_TASK_PRIORITY' && !APP_CONFIG.PRIORITIES.includes(text.toUpperCase())) throw new Error('Invalid default priority.'); if (key === 'TIMEZONE' && !text) throw new Error('Timezone is required.'); return booleanKeys.includes(key) ? text.toUpperCase() : text; }
function invalidateSettingCache_(key) { if (typeof CacheService !== 'undefined') CacheService.getScriptCache().remove('SETTING_' + key); }
