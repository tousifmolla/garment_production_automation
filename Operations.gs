function getSystemInfo() { requireAdmin_(); return { application: APP_CONFIG.APP_NAME, version: APP_CONFIG.VERSION, schemaVersion: APP_CONFIG.SCHEMA_VERSION, environment: PropertiesService.getScriptProperties().getProperty(APP_CONFIG.ENVIRONMENT_PROPERTY) || 'DEVELOPMENT' }; }
function setEnvironment(environment) { requireAdmin_(); const value=String(environment).toUpperCase(); if(!['DEVELOPMENT','TEST','PRODUCTION'].includes(value)) throw new Error('Environment must be DEVELOPMENT, TEST, or PRODUCTION.'); PropertiesService.getScriptProperties().setProperty(APP_CONFIG.ENVIRONMENT_PROPERTY,value); return getSystemInfo(); }
function logError(context,error,entityId) { const entry={timestamp:formatNow_(),user:(Session.getActiveUser().getEmail()||'system'),context:String(context||''),entityId:String(entityId||''),message:String(error&&error.message||error||'Unknown error'),environment:PropertiesService.getScriptProperties().getProperty(APP_CONFIG.ENVIRONMENT_PROPERTY)||'DEVELOPMENT'}; console.error(JSON.stringify(entry)); return entry; }
function systemHealthCheck() { const readiness=productionReadinessCheck(); return {version:APP_CONFIG.VERSION,environment:getSystemInfo().environment,ready:readiness.ready,failures:readiness.duplicateIdErrors,warnings:readiness.warnings||[],triggers:validateTriggers()}; }
