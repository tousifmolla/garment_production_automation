Total Orders = DISTINCTCOUNT(FactProduction[Order ID])
Completed Orders = CALCULATE([Total Orders], FactProduction[Order Status] = "COMPLETED")
Active Orders = CALCULATE([Total Orders], FactProduction[Order Status] <> "COMPLETED", FactProduction[Order Status] <> "CANCELLED")
Production Quantity = SUM(FactProduction[Order Quantity])
Completed Quantity = CALCULATE(SUM(FactProduction[Completed Quantity]), FactProduction[Order Status] = "COMPLETED")
WIP Quantity = CALCULATE(SUM(FactProduction[Order Quantity]), FactProduction[Order Status] <> "COMPLETED", FactProduction[Order Status] <> "CANCELLED")
Completion % = DIVIDE([Completed Quantity], [Production Quantity])
On-Time Delivery % = DIVIDE(CALCULATE([Total Orders], FactProduction[Order Status] = "COMPLETED", FactProduction[On Time] = TRUE()), [Completed Orders])
Average Cycle Time = AVERAGEX(VALUES(FactOrderCycle[Order ID]), CALCULATE(MAX(FactOrderCycle[Total Cycle Hours])))
Overdue Tasks = CALCULATE(DISTINCTCOUNT(FactTasks[Task ID]), FactTasks[Status] = "OVERDUE")
Department Throughput = SUM(FactDailyProduction[Quantity Completed])
Total Tasks = DISTINCTCOUNT(FactTasks[Task ID])
Completed Tasks = CALCULATE([Total Tasks], FactTasks[Status] = "COMPLETED")
Pending Tasks = CALCULATE([Total Tasks], FactTasks[Status] = "PENDING")
In Progress Tasks = CALCULATE([Total Tasks], FactTasks[Status] = "IN_PROGRESS")
Average Task Duration = AVERAGE(FactTasks[Task Duration Hours])
Average Delay Hours = AVERAGE(FactTasks[Delay Hours])
Late Orders = CALCULATE([Total Orders], FactProduction[Order Status] = "COMPLETED", FactProduction[On Time] = FALSE())
Average Delivery Delay Hours = CALCULATE(AVERAGE(FactProduction[Delay Hours]), FactProduction[Order Status] = "COMPLETED", FactProduction[On Time] = FALSE())
Average Stage Duration = AVERAGE(FactOrderCycle[Stage Duration Hours])
